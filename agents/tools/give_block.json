{
  "type": "client",
  "name": "give_block",
  "description": "Daje dziecku określoną liczbę bloków do budowania w świecie gry.",
  "parameters": {
    "type": "object",
    "properties": {
      "block_type": {
        "type": "string",
        "enum": ["planks", "cobblestone", "glass", "iron_block"],
        "description": "Rodzaj bloku do przekazania."
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16,
        "description": "Liczba bloków (maksymalnie 16 na raz)."
      }
    },
    "required": ["block_type", "count"]
  }
}
